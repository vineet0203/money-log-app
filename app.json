{
  "expo": {
    "name": "Money Log",
    "slug": "moneylog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moneylog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.moneylog.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6BCB77"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.moneylog",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash.png",
          "imageWidth": 350,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d5890453-0ac4-48a0-a03d-7d3b511af67a"
      }
    },
    "owner": "moneylogdevs-team"
  }
}
