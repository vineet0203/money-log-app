{
  "expo": {
    "name": "moneylog",
    "slug": "moneylog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moneylog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.computerlog.moneylog",
      "buildNumber": "2",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Money Log to use Face ID for fast and secure authentication.",
        "NSPhotoLibraryUsageDescription": "Allow Money Log to select photos for your profile picture and receipts.",
        "NSCameraUsageDescription": "Allow Money Log to access your camera to take a profile picture or scan receipts.",
        "NSLocationWhenInUseUsageDescription": "Allow Money Log to access your location to show where transactions occurred.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6BCB77"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.moneylog",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash.png",
          "imageWidth": 350,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "compileSdkVersion": 36,
            "minSdkVersion": 26,
            "ndkVersion": "26.1.10909125"
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90e6de61-cb81-4332-8448-effe6c0c5249"
      }
    },
    "owner": "bipul-work-team"
  }
}
